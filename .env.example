# =============================================================================
# COFRE DE VARIÁVEIS DE AMBIENTE — ProjetoARIANO
# =============================================================================
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores reais no .env (NUNCA commite o .env)
#   3. O arquivo .env está no .gitignore — senhas reais JAMAIS vão ao GitHub
# =============================================================================

# -----------------------------------------------------------------------------
# Neo4j Aura (banco de grafos em produção)
# Obtenha as credenciais em: https://console.neo4j.io/
# ATENÇÃO: Use o formato neo4j+s:// para Neo4j Aura (TLS obrigatório)
# -----------------------------------------------------------------------------
NEO4J_URI=neo4j+s://<seu-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=insira_sua_senha_aqui

# -----------------------------------------------------------------------------
# OpenRouter LLM
# Obtenha sua chave em: https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# Backend / CORS
# -----------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
DEBUG=true
